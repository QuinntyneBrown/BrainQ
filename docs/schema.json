{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brainq/vector-db-schema",
  "title": "BrainQ Personal Brain — Vector Database Schema",
  "description": "Schema for a vector database that stores notes, ideas, commitments, contacts, and projects for a personal knowledge and productivity system.",
  "version": "1.0.0",
  "vectorConfig": {
    "defaultDimensions": 1536,
    "distanceMetric": "cosine",
    "embeddingModels": {
      "default": "text-embedding-ada-002",
      "alternatives": [
        "text-embedding-3-small",
        "text-embedding-3-large",
        "sentence-transformers/all-MiniLM-L6-v2"
      ]
    }
  },
  "collections": {
    "Note": {
      "description": "Free-form written notes — fleeting thoughts, meeting notes, reference material, journal entries, etc.",
      "vectorField": {
        "name": "embedding",
        "dimensions": 1536,
        "distanceMetric": "cosine",
        "sourceFields": ["title", "content", "tags"]
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the note."
        },
        "title": {
          "type": "string",
          "description": "Short descriptive title of the note."
        },
        "content": {
          "type": "string",
          "description": "Full body text of the note (supports Markdown)."
        },
        "category": {
          "type": "string",
          "enum": ["fleeting", "permanent", "literature", "meeting", "journal", "reference", "other"],
          "description": "Zettelkasten-inspired category that describes the type of note."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Free-form tags used for filtering and linking."
        },
        "source": {
          "type": "string",
          "description": "Optional origin of the note (URL, book title, person, etc.)."
        },
        "linkedIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "UUIDs of related items in any collection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the note was first created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the note was last modified."
        }
      },
      "required": ["id", "title", "content", "createdAt", "updatedAt"],
      "indexes": ["category", "tags", "createdAt"]
    },

    "Idea": {
      "description": "Creative ideas, hypotheses, inventions, or opportunities worth capturing and incubating.",
      "vectorField": {
        "name": "embedding",
        "dimensions": 1536,
        "distanceMetric": "cosine",
        "sourceFields": ["title", "description", "tags"]
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the idea."
        },
        "title": {
          "type": "string",
          "description": "Concise name for the idea."
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation — what it is, why it matters, how it might work."
        },
        "status": {
          "type": "string",
          "enum": ["raw", "exploring", "validating", "parked", "implemented", "discarded"],
          "description": "Lifecycle stage of the idea."
        },
        "excitement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Subjective excitement score (1 = low, 5 = very high)."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Topics or domains this idea belongs to."
        },
        "linkedIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "UUIDs of related items in any collection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the idea was captured."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the idea was last modified."
        }
      },
      "required": ["id", "title", "description", "status", "createdAt", "updatedAt"],
      "indexes": ["status", "excitement", "tags", "createdAt"]
    },

    "Commitment": {
      "description": "Ongoing personal commitments and habit goals — exercise routines, dietary goals, reading targets, sleep schedules, etc.",
      "vectorField": {
        "name": "embedding",
        "dimensions": 1536,
        "distanceMetric": "cosine",
        "sourceFields": ["title", "description", "type"]
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the commitment."
        },
        "title": {
          "type": "string",
          "description": "Short name (e.g. 'Morning Run', 'Read 20 Pages', 'No Sugar')."
        },
        "description": {
          "type": "string",
          "description": "Why this commitment matters and any relevant detail."
        },
        "type": {
          "type": "string",
          "enum": ["exercise", "nutrition", "reading", "sleep", "meditation", "learning", "social", "financial", "creative", "other"],
          "description": "Domain the commitment belongs to."
        },
        "frequency": {
          "type": "string",
          "enum": ["daily", "weekdays", "weekends", "weekly", "biweekly", "monthly", "custom"],
          "description": "How often this commitment should be performed."
        },
        "target": {
          "type": "object",
          "description": "Quantitative goal for each occurrence.",
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string", "examples": ["minutes", "pages", "km", "reps", "glasses", "hours"] }
          }
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "completed", "abandoned"],
          "description": "Current state of the commitment."
        },
        "startDate": {
          "type": "string",
          "format": "date",
          "description": "ISO-8601 date when this commitment began or will begin."
        },
        "endDate": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO-8601 date when this commitment ends. Null means indefinite."
        },
        "checkIns": {
          "type": "array",
          "description": "Log of individual check-in records for tracking.",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": "string", "format": "date" },
              "completed": { "type": "boolean" },
              "actualValue": { "type": "number" },
              "note": { "type": "string" }
            },
            "required": ["date", "completed"]
          }
        },
        "linkedIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "UUIDs of related projects, notes, or ideas."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when this commitment was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when this commitment was last modified."
        }
      },
      "required": ["id", "title", "type", "frequency", "status", "startDate", "createdAt", "updatedAt"],
      "indexes": ["type", "frequency", "status", "startDate"]
    },

    "Contact": {
      "description": "People in your personal and professional network — friends, family, colleagues, mentors, etc.",
      "vectorField": {
        "name": "embedding",
        "dimensions": 1536,
        "distanceMetric": "cosine",
        "sourceFields": ["fullName", "notes", "tags", "organization"]
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the contact."
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the person."
        },
        "email": {
          "type": "array",
          "items": { "type": "string", "format": "email" },
          "description": "One or more email addresses."
        },
        "phone": {
          "type": "array",
          "items": { "type": "string" },
          "description": "One or more phone numbers (E.164 format recommended)."
        },
        "organization": {
          "type": "string",
          "description": "Company, school, or other affiliation."
        },
        "role": {
          "type": "string",
          "description": "Job title or role within their organization."
        },
        "relationshipType": {
          "type": "string",
          "enum": ["family", "friend", "colleague", "mentor", "mentee", "acquaintance", "professional", "other"],
          "description": "How this person is related to you."
        },
        "socialProfiles": {
          "type": "object",
          "description": "Links to social media or professional profiles.",
          "properties": {
            "linkedin": { "type": "string", "format": "uri" },
            "twitter": { "type": "string" },
            "github": { "type": "string" },
            "website": { "type": "string", "format": "uri" }
          },
          "additionalProperties": { "type": "string" }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Topics, communities, or attributes associated with this contact."
        },
        "notes": {
          "type": "string",
          "description": "Free-form observations, context, or conversation history about this person."
        },
        "lastContactedAt": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO-8601 timestamp of the most recent meaningful interaction."
        },
        "linkedIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "UUIDs of related notes, projects, or ideas involving this contact."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the contact was added."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the contact was last modified."
        }
      },
      "required": ["id", "fullName", "createdAt", "updatedAt"],
      "indexes": ["relationshipType", "organization", "tags", "lastContactedAt"]
    },

    "Project": {
      "description": "Multi-step endeavors with a clear goal — side projects, work initiatives, home improvements, learning goals, etc.",
      "vectorField": {
        "name": "embedding",
        "dimensions": 1536,
        "distanceMetric": "cosine",
        "sourceFields": ["title", "description", "goals", "tags"]
      },
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the project."
        },
        "title": {
          "type": "string",
          "description": "Name of the project."
        },
        "description": {
          "type": "string",
          "description": "Overview of what the project is and why it exists."
        },
        "status": {
          "type": "string",
          "enum": ["idea", "planning", "active", "on_hold", "completed", "cancelled"],
          "description": "Current lifecycle stage of the project."
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low"],
          "description": "Relative priority compared to other active projects."
        },
        "goals": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of desired outcomes or success criteria for this project."
        },
        "tasks": {
          "type": "array",
          "description": "Actionable next steps or work items within this project.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "title": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["todo", "in_progress", "blocked", "done", "cancelled"]
              },
              "dueDate": { "type": ["string", "null"], "format": "date" },
              "notes": { "type": "string" }
            },
            "required": ["id", "title", "status"]
          }
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Topics, technologies, or domains this project spans."
        },
        "startDate": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO-8601 date when work on the project started or is planned to start."
        },
        "targetDate": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO-8601 target completion date."
        },
        "completedDate": {
          "type": ["string", "null"],
          "format": "date",
          "description": "ISO-8601 date when the project was actually completed."
        },
        "linkedIds": {
          "type": "array",
          "items": { "type": "string", "format": "uuid" },
          "description": "UUIDs of related notes, ideas, contacts, or commitments."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the project was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp when the project was last modified."
        }
      },
      "required": ["id", "title", "description", "status", "createdAt", "updatedAt"],
      "indexes": ["status", "priority", "tags", "startDate", "targetDate"]
    }
  }
}
